---
import { getExperience } from "../services";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = getExperience(lang);
---

<section id="experience" class="py-24 border-t border-border">
  <div class="container">
    <div class="mb-16">
      <p class="font-mono text-primary text-sm tracking-widest uppercase mb-3">{data.kicker}</p>
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tight">{data.title}</h2>
    </div>

    <div class="space-y-0">
      {data.items.map((exp) => (
        <div class="group grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-4 lg:gap-10 py-10 border-b border-border last:border-b-0 hover:bg-card/50 -mx-6 px-6 rounded-lg transition-colors">
          <div>
            <p class="font-mono text-sm text-muted-foreground whitespace-nowrap">{exp.period}</p>
            {exp.location && (
              <p class="font-mono text-xs text-muted-foreground/60 mt-1">📍 {exp.location}</p>
            )}
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-1">{exp.role}</h3>
            <p class="text-primary font-mono text-sm mb-3">{exp.company}</p>
            <p class="text-muted-foreground mb-3">{exp.description}</p>
            {exp.highlights && (
              <ul class="text-muted-foreground text-sm space-y-1 mb-4 list-none">
                {exp.highlights.map((h) => (
                  <li class="flex gap-2">
                    <span class="text-primary shrink-0">→</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            )}
            <div class="flex flex-wrap gap-2">
              {exp.stack.map((tech) => (
                <span class="px-2.5 py-1 text-xs font-mono rounded bg-secondary text-secondary-foreground">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
