---
import { getExperience } from "../../services";
import type { Lang } from "../../i18n";
import { getUi, noDash, splitLead } from "./ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const experience = getExperience(lang);
const ui = getUi(lang);
---

<!--
  Sticky rail on the left keeps the whole track visible while the detail column
  scrolls. Six roles with long project lists would be an unreadable wall as a flat
  list, so each entry is a native <details>. No JavaScript.
-->
<section id="work" class="border-t border-v2-line bg-v2-surface">
  <div class="mx-auto max-w-[1240px] scroll-mt-24 px-5 py-20 sm:px-8 md:py-28">
    <div class="grid gap-10 md:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] md:gap-16">
      <div class="md:sticky md:top-24 md:self-start">
        <h2 class="text-[22px] font-semibold tracking-tight">{ui.work}</h2>
        <span class="v2-rule mt-3"></span>

        <ol class="mt-6 hidden space-y-2.5 md:block">
          {
            experience.items.map((item) => (
              <li class="flex items-baseline justify-between gap-3 text-[13px]">
                <span class="truncate text-v2-mut">{item.company}</span>
                <span class="tnum shrink-0 font-geist-mono text-[11.5px] text-v2-mut/70">
                  {noDash(item.period).split(/\s*-\s*/)[0]}
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="space-y-3">
        {
          experience.items.map((item, i) => (
            <details
              open={i === 0}
              class="v2-card group rounded-v2 border border-v2-line bg-v2-bg px-5 py-4 md:px-7 md:py-6"
            >
              <summary class="flex cursor-pointer list-none flex-wrap items-baseline gap-x-4 gap-y-1 [&::-webkit-details-marker]:hidden">
                <span class="text-[17px] font-semibold tracking-tight md:text-[19px]">
                  {item.company}
                </span>
                <span class="text-[15px] text-v2-mut">{item.role}</span>
                <span class="tnum ml-auto font-geist-mono text-[12.5px] whitespace-nowrap text-v2-mut">
                  {noDash(item.period)}
                </span>
                <span
                  aria-hidden="true"
                  class="text-v2-mut transition-transform duration-300 group-open:rotate-45"
                >
                  +
                </span>
              </summary>

              <div class="mt-5 border-t border-v2-line pt-5">
                {item.location && (
                  <p class="text-[13px] text-v2-mut">{noDash(item.location)}</p>
                )}
                <p class="mt-2 max-w-[70ch] text-[15.5px] leading-relaxed">
                  {noDash(item.description)}
                </p>

                {item.highlights && (
                  <ul class="v2-list mt-5 space-y-3">
                    {item.highlights.map((h) => {
                      const { lead, text } = splitLead(h);
                      return (
                        <li class="max-w-[76ch] text-[15px] leading-relaxed text-v2-mut">
                          {lead && <b class="font-semibold text-v2-ink">{lead}. </b>}
                          {text}
                        </li>
                      );
                    })}
                  </ul>
                )}

                <ul class="mt-6 flex flex-wrap gap-2">
                  {item.stack.map((tech) => (
                    <li class="rounded-full border border-v2-line px-3 py-1 font-geist-mono text-[11.5px] text-v2-mut">
                      {tech}
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
