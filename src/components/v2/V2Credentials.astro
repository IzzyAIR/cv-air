---
import { getEducation } from "../../services";
import type { Lang } from "../../i18n";
import { getUi, noDash } from "./ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const education = getEducation(lang);
const ui = getUi(lang);
---

<section class="border-y border-v2-line bg-v2-surface">
  <div class="mx-auto grid max-w-[1240px] gap-12 px-5 py-20 sm:px-8 md:grid-cols-2 md:py-24">
    <div>
      <h2 class="v2-reveal text-[22px] font-semibold tracking-tight">{ui.education}</h2>
      <div class="mt-6 space-y-6">
        {
          education.education.map((e) => (
            <div class="v2-reveal">
              <p class="text-[16px] font-medium">{e.school}</p>
              <p class="mt-1 text-[14.5px] text-v2-mut">{noDash(e.degree)}</p>
              <p class="tnum mt-1 font-geist-mono text-[12.5px] text-v2-mut">
                {noDash(e.period)}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div>
      <h2 class="v2-reveal text-[22px] font-semibold tracking-tight">{ui.languages}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          education.languages.map((l) => (
            <div class="v2-reveal">
              <p class="text-[16px] font-medium">{l.name}</p>
              <p class="mt-1 text-[14.5px] text-v2-mut">{noDash(l.level)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
