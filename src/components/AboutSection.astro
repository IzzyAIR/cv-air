---
import { getAbout } from "../services";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const about = getAbout(lang);
---

<section id="about" class="py-24 border-t border-border">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <p class="font-mono text-primary text-sm tracking-widest uppercase mb-3">{about.kicker}</p>
        <h2 class="text-4xl sm:text-5xl font-bold tracking-tight mb-8">
          {about.titleLeading}
          <br />
          <span class="text-gradient">{about.titleHighlighted}</span>{about.titleTrailing}
        </h2>
      </div>
      <div class="space-y-5 text-muted-foreground text-lg leading-relaxed">
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <div class="grid grid-cols-2 gap-6 pt-6">
          {about.stats.map((stat) => (
            <div class="border-l-2 border-primary pl-4">
              <p class="text-3xl font-bold text-foreground">{stat.value}</p>
              <p class="text-sm text-muted-foreground font-mono">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
