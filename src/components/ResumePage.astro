---
import {
  getHero,
  getAbout,
  getTechStack,
  getExperience,
  getEducation,
  getContact,
} from "../services";
import { langHref, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const hero = getHero(lang);
const about = getAbout(lang);
const tech = getTechStack(lang);
const experience = getExperience(lang);
const education = getEducation(lang);
const contact = getContact(lang);

const ui = {
  en: { download: "Download PDF", summary: "Summary", experience: "Experience", education: "Education", skills: "Technical Skills", languages: "Languages", back: "Back to site" },
  ru: { download: "Скачать PDF", summary: "О себе", experience: "Опыт работы", education: "Образование", skills: "Технические навыки", languages: "Языки", back: "На сайт" },
  uz: { download: "PDF yuklab olish", summary: "Men haqimda", experience: "Tajriba", education: "Ta'lim", skills: "Texnik ko‘nikmalar", languages: "Tillar", back: "Saytga qaytish" },
}[lang];

const title = hero.tagline.replace(/[<>/]/g, "").trim();
const location = hero.meta.replace(/^📍\s*/, "");
const phone = contact.links.find((l) => l.type === "phone")?.label.replace(/^📞\s*/, "");
const telegram = contact.links.find((l) => l.type === "telegram")?.href;
const portfolio = contact.links.find((l) => l.type === "portfolio")?.href;
const clean = (url?: string) => url?.replace(/^https?:\/\//, "").replace(/\/$/, "");
const fileName = `${hero.firstName}-${hero.lastName}-CV-${lang.toUpperCase()}`;
---

<!doctype html>
<html lang={lang} translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{`${hero.firstName} ${hero.lastName} — ${title}`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="toolbar no-print">
      <a href={langHref(lang)} class="btn-link">← {ui.back}</a>
      <button id="download-btn" class="btn-print">{ui.download}</button>
    </div>

    <main class="sheet">
      <header class="head">
        <h1>{hero.firstName} {hero.lastName}</h1>
        <p class="role">{title}</p>
        <div class="contacts">
          <span>{contact.email}</span>
          {phone && <span>{phone}</span>}
          {telegram && <span>{clean(telegram)}</span>}
          {portfolio && <span>{clean(portfolio)}</span>}
          <span>{location}</span>
        </div>
      </header>

      <section>
        <h2>{ui.summary}</h2>
        <p class="lead">{hero.summary}</p>
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </section>

      <section>
        <h2>{ui.experience}</h2>
        {experience.items.map((item) => (
          <div class="entry">
            <div class="entry-head">
              <span class="entry-title">{item.role} · {item.company}</span>
              <span class="entry-period">{item.period}</span>
            </div>
            {item.location && <p class="entry-meta">{item.location}</p>}
            <p class="entry-desc">{item.description}</p>
            {item.highlights && (
              <ul>
                {item.highlights.map((h) => <li>{h}</li>)}
              </ul>
            )}
            <p class="entry-stack">{item.stack.join(" · ")}</p>
          </div>
        ))}
      </section>

      <section>
        <h2>{ui.skills}</h2>
        <dl class="skills">
          {tech.categories.map((c) => (
            <div class="skill-row">
              <dt>{c.title}</dt>
              <dd>{c.items.join(", ")}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="two-col">
        <div>
          <h2>{ui.education}</h2>
          {education.education.map((e) => (
            <div class="entry">
              <div class="entry-head">
                <span class="entry-title">{e.school}</span>
                <span class="entry-period">{e.period}</span>
              </div>
              <p class="entry-meta">{e.degree}</p>
            </div>
          ))}
        </div>
        <div>
          <h2>{ui.languages}</h2>
          <ul class="langs">
            {education.languages.map((l) => (
              <li><strong>{l.name}</strong> — {l.level}</li>
            ))}
          </ul>
        </div>
      </section>
    </main>

    <script is:inline define:vars={{ fileName }}>
      document.title = fileName;
      document.getElementById("download-btn").addEventListener("click", () => window.print());
    </script>

    <style>
      :root {
        --ink: #1a1a1a;
        --muted: #555;
        --line: #d8d8d8;
        --accent: #b45309;
      }
      * { box-sizing: border-box; }
      html { background: #525659; }
      body {
        margin: 0;
        font-family: "Inter", system-ui, sans-serif;
        color: var(--ink);
        font-size: 10.5pt;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .toolbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        justify-content: center;
        gap: 12px;
        padding: 14px;
        background: rgba(20, 20, 20, 0.85);
        backdrop-filter: blur(8px);
      }
      .btn-link, .btn-print {
        font: inherit;
        font-size: 13px;
        font-weight: 500;
        padding: 9px 18px;
        border-radius: 8px;
        cursor: pointer;
        border: 1px solid rgba(255, 255, 255, 0.25);
        text-decoration: none;
      }
      .btn-link { color: #e5e5e5; background: transparent; display: inline-flex; align-items: center; }
      .btn-print { color: #1a1a1a; background: #f5b94d; border-color: #f5b94d; }
      .btn-print:hover { background: #f7c869; }

      .sheet {
        width: 210mm;
        min-height: 297mm;
        margin: 24px auto;
        padding: 16mm 15mm;
        background: #fff;
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.35);
      }

      .head { border-bottom: 2px solid var(--ink); padding-bottom: 14px; margin-bottom: 22px; }
      h1 {
        font-family: "Instrument Serif", Georgia, serif;
        font-size: 34pt;
        line-height: 1;
        margin: 0 0 4px;
        letter-spacing: -0.01em;
      }
      .role { font-size: 12pt; font-weight: 500; color: var(--accent); margin: 0 0 10px; }
      .contacts { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 9pt; color: var(--muted); }
      .contacts span { position: relative; }
      .contacts span + span::before {
        content: "";
        position: absolute;
        left: -8px;
        top: 4px;
        bottom: 4px;
        border-left: 1px solid var(--line);
      }

      section { margin-bottom: 20px; }
      h2 {
        font-size: 9pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--accent);
        border-bottom: 1px solid var(--line);
        padding-bottom: 5px;
        margin: 0 0 12px;
      }
      p { margin: 0 0 7px; }
      .lead { font-weight: 500; }

      .entry { margin-bottom: 14px; break-inside: avoid; }
      .entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
      .entry-title { font-weight: 600; font-size: 11pt; }
      .entry-period { font-size: 9pt; color: var(--muted); white-space: nowrap; }
      .entry-meta { font-size: 9pt; color: var(--muted); margin: 1px 0 5px; }
      .entry-desc { margin-bottom: 5px; }
      ul { margin: 0 0 6px; padding-left: 16px; }
      li { margin-bottom: 3px; }
      .entry-stack { font-size: 8.5pt; color: var(--muted); }

      .skills { margin: 0; }
      .skill-row { display: grid; grid-template-columns: 130px 1fr; gap: 12px; padding: 3px 0; break-inside: avoid; }
      dt { font-weight: 600; }
      dd { margin: 0; color: #333; }

      .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
      .langs { list-style: none; padding: 0; margin: 0; }
      .langs li { margin-bottom: 4px; }

      @page { size: A4; margin: 14mm; }
      @media print {
        html { background: #fff; }
        .no-print { display: none !important; }
        .sheet {
          width: auto;
          min-height: 0;
          margin: 0;
          padding: 0;
          box-shadow: none;
        }
        body { font-size: 10pt; }
      }
    </style>
  </body>
</html>
