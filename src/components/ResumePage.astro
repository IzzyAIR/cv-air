---
import "@fontsource-variable/geist/index.css";
import "@fontsource-variable/geist-mono/index.css";
import {
  getHero,
  getAbout,
  getTechStack,
  getExperience,
  getEducation,
  getContact,
} from "../services";
import { langHref, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const hero = getHero(lang);
const about = getAbout(lang);
const tech = getTechStack(lang);
const experience = getExperience(lang);
const education = getEducation(lang);
const contact = getContact(lang);

const ui = {
  en: { download: "Download PDF", back: "Back to site", summary: "Professional Summary", experience: "Work Experience", education: "Education", skills: "Technical Skills", languages: "Languages", stack: "Stack", pages: "pages" },
  ru: { download: "Скачать PDF", back: "На сайт", summary: "О себе", experience: "Опыт работы", education: "Образование", skills: "Технические навыки", languages: "Языки", stack: "Стек", pages: "стр." },
  uz: { download: "PDF yuklab olish", back: "Saytga qaytish", summary: "Men haqimda", experience: "Ish tajribasi", education: "Ta'lim", skills: "Texnik ko‘nikmalar", languages: "Tillar", stack: "Stek", pages: "bet" },
}[lang];

const title = hero.tagline.replace(/[<>/]/g, "").trim();
const [location, ...availability] = hero.meta
  .replace(/^📍\s*/, "")
  .split("·")
  .map((s) => s.trim());
const phone = contact.links.find((l) => l.type === "phone");
const telegram = contact.links.find((l) => l.type === "telegram")?.href;
const portfolio = contact.links.find((l) => l.type === "portfolio")?.href;
const clean = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
const fullName = `${hero.firstName} ${hero.lastName}`;
const fileName = `${hero.firstName}-${hero.lastName}-CV-${lang.toUpperCase()}`;

const HIDDEN_SKILLS = ["Forms & Validation", "Формы и валидация", "Formalar va validatsiya"];
const skillCategories = tech.categories.filter((c) => !HIDDEN_SKILLS.includes(c.title));

// "Project — description" → bold lead-in, keeps bullets scannable for a 6-second HR pass
const splitHighlight = (h: string) => {
  const m = h.match(/^(.{2,70}?)\s+—\s+([\s\S]+)$/);
  return m ? { lead: m[1], text: m[2] } : { lead: "", text: h };
};
---

<!doctype html>
<html lang={lang} translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{`${fullName} — ${title}`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* chrome follows the theme pinned on the site; the sheet itself stays white */}
    <script is:inline>
      try {
        const saved = localStorage.getItem("v2-theme");
        if (saved === "light" || saved === "dark")
          document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <div class="toolbar no-print">
      <a href={langHref(lang)} class="btn-link">← {ui.back}</a>
      <span class="meta-chip">A4 · <span id="page-count">1</span> {ui.pages}</span>
      <button id="download-btn" class="btn-print">{ui.download}</button>
    </div>

    <div id="stage">
      <div id="paper">
        <div id="flow">
          <header class="block head">
            <h1>{fullName}</h1>
            <p class="role">{title}</p>
            <p class="headline">{hero.headline}</p>
            <ul class="contacts">
              <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
              {phone && <li><a href={phone.href}>{phone.label.replace(/^📞\s*/, "")}</a></li>}
              {telegram && <li><a href={telegram}>{clean(telegram)}</a></li>}
              {portfolio && <li><a href={portfolio}>{clean(portfolio)}</a></li>}
              <li>{location}</li>
            </ul>
            {availability.length > 0 && <p class="availability">{availability.join(" · ")}</p>}
          </header>

          <h2 class="block sec">{ui.summary}</h2>
          <p class="block lead">{hero.summary}</p>
          {about.paragraphs.map((p) => <p class="block">{p}</p>)}

          <h2 class="block sec">{ui.skills}</h2>
          {skillCategories.map((c) => (
            <div class="block skill-row">
              <span class="skill-title">{c.title}</span>
              <span class="skill-items">{c.items.join(", ")}</span>
            </div>
          ))}

          <h2 class="block sec">{ui.experience}</h2>
          {experience.items.map((item) => (
            <>
              <div class="block entry-head">
                <div class="entry-line">
                  <span class="entry-role">{item.role}</span>
                  <span class="entry-period">{item.period}</span>
                </div>
                <div class="entry-line">
                  <span class="entry-company">{item.company}</span>
                  {item.location && <span class="entry-location">{item.location}</span>}
                </div>
              </div>
              <p class="block entry-desc">{item.description}</p>
              {item.highlights?.map((h) => {
                const { lead, text } = splitHighlight(h);
                return (
                  <p class="block hl">
                    {lead && <strong>{lead} — </strong>}{text}
                  </p>
                );
              })}
              <p class="block entry-stack"><span class="stack-label">{ui.stack}:</span> {item.stack.join(" · ")}</p>
            </>
          ))}

          <h2 class="block sec">{ui.education}</h2>
          {education.education.map((e) => (
            <div class="block entry-head">
              <div class="entry-line">
                <span class="entry-role">{e.school}</span>
                <span class="entry-period">{e.period}</span>
              </div>
              <div class="entry-line"><span class="entry-company">{e.degree}</span></div>
            </div>
          ))}

          <h2 class="block sec">{ui.languages}</h2>
          <div class="block langs">
            {education.languages.map((l) => (
              <span class="lang"><strong>{l.name}</strong> — {l.level}</span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ fileName, fullName }}>
      document.title = fileName;

      const stage = document.getElementById("stage");
      const paper = document.getElementById("paper");
      const flow = document.getElementById("flow");

      const el = (tag, cls, text) => {
        const n = document.createElement(tag);
        n.className = cls;
        if (text) n.textContent = text;
        return n;
      };

      function paginate() {
        const blocks = [...flow.children];
        flow.remove();
        paper.textContent = "";

        let body;
        const addPage = () => {
          const page = el("div", "page");
          body = el("div", "page-body");
          page.append(body);
          paper.append(page);
        };
        addPage();

        for (const block of blocks) {
          body.append(block);
          if (body.scrollHeight <= body.clientHeight + 1) continue;
          const prev = body;
          addPage();
          body.append(block);
          // never leave a section/entry heading orphaned at the bottom of a page
          let last = prev.lastElementChild;
          while (last && prev.children.length > 1 && /\b(sec|entry-head)\b/.test(last.className)) {
            body.prepend(last);
            last = prev.lastElementChild;
          }
        }

        const pages = [...paper.children];
        pages.forEach((page, i) => {
          page.append(el("div", "page-num", `${fullName} — ${i + 1} / ${pages.length}`));
        });
        document.getElementById("page-count").textContent = pages.length;
      }

      // A4 width in CSS px — scale the preview down on narrow screens
      function fit() {
        const scale = Math.min(1, (stage.clientWidth - 24) / 794);
        paper.style.transform = scale < 1 ? `scale(${scale})` : "";
        stage.style.height = scale < 1 ? `${paper.offsetHeight * scale}px` : "";
      }

      // The stylesheet that gives .page-body its fixed height sits *below* this script,
      // and fonts.ready resolves before the parser reaches it: paginating that early
      // measures an unbounded box and puts every block on a single page. Wait for the
      // document to finish parsing first, then for the fonts.
      const boot = () =>
        (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => {
          paginate();
          fit();
        });

      if (document.readyState === "loading")
        addEventListener("DOMContentLoaded", boot, { once: true });
      else boot();
      addEventListener("resize", fit);
      document.getElementById("download-btn").addEventListener("click", () => window.print());
    </script>

    <!-- inline (unscoped): pages are created by the pagination script, so scoped ids wouldn't stick -->
    <style is:inline>
      /* Sheet palette: the v2 Cold Luxury system rendered on paper. Ink stays
         near-black and the accent is the same cobalt as the site, dark enough
         to survive a greyscale print. */
      :root {
        --ink: hsl(220 24% 8%);
        --body: hsl(218 16% 26%);
        --soft: hsl(218 12% 46%);
        --line: hsl(216 20% 88%);
        --accent: hsl(230 68% 48%);
        --page-w: 210mm;
        --page-h: 297mm;
        --pad-x: 15mm;
        --pad-t: 13mm;
        --pad-b: 14mm;

        /* chrome (toolbar + stage) — mirrors v2 light */
        --c-bg: hsl(220 24% 97%);
        --c-surface: hsl(0 0% 100% / 0.72);
        --c-ink: hsl(220 24% 8%);
        --c-mut: hsl(218 12% 42%);
        --c-line: hsl(216 20% 89%);
        --c-accent: hsl(230 68% 51%);
        --c-accent-ink: hsl(0 0% 100%);
        --c-shadow: hsl(220 30% 12% / 0.18);
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --c-bg: hsl(216 18% 6%);
          --c-surface: hsl(217 17% 10% / 0.72);
          --c-ink: hsl(214 22% 92%);
          --c-mut: hsl(216 12% 65%);
          --c-line: hsl(217 16% 17%);
          --c-accent: hsl(227 72% 74%);
          --c-accent-ink: hsl(227 60% 12%);
          --c-shadow: hsl(216 40% 2% / 0.55);
          color-scheme: dark;
        }
      }
      :root[data-theme="dark"] {
        --c-bg: hsl(216 18% 6%);
        --c-surface: hsl(217 17% 10% / 0.72);
        --c-ink: hsl(214 22% 92%);
        --c-mut: hsl(216 12% 65%);
        --c-line: hsl(217 16% 17%);
        --c-accent: hsl(227 72% 74%);
        --c-accent-ink: hsl(227 60% 12%);
        --c-shadow: hsl(216 40% 2% / 0.55);
        color-scheme: dark;
      }
      :root[data-theme="light"] {
        --c-bg: hsl(220 24% 97%);
        --c-surface: hsl(0 0% 100% / 0.72);
        --c-ink: hsl(220 24% 8%);
        --c-mut: hsl(218 12% 42%);
        --c-line: hsl(216 20% 89%);
        --c-accent: hsl(230 68% 51%);
        --c-accent-ink: hsl(0 0% 100%);
        --c-shadow: hsl(220 30% 12% / 0.18);
        color-scheme: light;
      }

      * { box-sizing: border-box; }
      html { background: var(--c-bg); }
      body {
        margin: 0;
        font-family: "Geist Variable", Geist, Arial, system-ui, sans-serif;
        color: var(--body);
        font-size: 10.2pt;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      .mono {
        font-family: "Geist Mono Variable", "Geist Mono", ui-monospace, monospace;
      }

      /* ---------- toolbar ---------- */
      .toolbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px;
        background: var(--c-surface);
        border-bottom: 1px solid var(--c-line);
        backdrop-filter: blur(12px);
      }
      .btn-link, .btn-print {
        font: inherit;
        font-size: 13px;
        font-weight: 500;
        padding: 8px 18px;
        border-radius: 999px;
        cursor: pointer;
        border: 1px solid var(--c-line);
        background: transparent;
        transition: border-color 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
      }
      .btn-link { color: var(--c-ink); }
      .btn-link:hover { border-color: var(--c-accent); }
      .btn-print {
        color: var(--c-accent-ink);
        background: var(--c-accent);
        border-color: var(--c-accent);
      }
      .btn-print:hover { transform: translateY(-1px); opacity: 0.92; }
      .meta-chip {
        font-family: "Geist Mono Variable", "Geist Mono", ui-monospace, monospace;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--c-mut);
      }

      /* ---------- pages ---------- */
      #stage { padding: 24px 12px 40px; }
      #paper {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        transform-origin: top center;
      }
      .page {
        position: relative;
        flex: none;
        width: var(--page-w);
        height: var(--page-h);
        padding: var(--pad-t) var(--pad-x) var(--pad-b);
        background: #fff;
        box-shadow: 0 30px 70px -30px var(--c-shadow);
        outline: 1px solid var(--c-line);
        overflow: hidden;
      }
      .page-body {
        display: flex;
        flex-direction: column;
        gap: 3.4mm;
        /* fixed, not 100% — the print rule shaves the page box, not the type area */
        height: calc(var(--page-h) - var(--pad-t) - var(--pad-b));
        overflow: hidden;
      }
      .page-body > * { flex: none; }
      .page-num {
        position: absolute;
        left: var(--pad-x);
        right: var(--pad-x);
        bottom: 6mm;
        padding-top: 2mm;
        border-top: 1px solid var(--line);
        font-family: "Geist Mono Variable", "Geist Mono", ui-monospace, monospace;
        font-size: 7pt;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--soft);
        text-align: right;
      }

      /* ---------- header ---------- */
      .head {
        position: relative;
        border-bottom: 1px solid var(--line);
        padding-bottom: 4mm;
      }
      /* accent segment fading into the hairline — the sheet's echo of .v2-rule */
      .head::after,
      h2.sec::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -1px;
        height: 2px;
        width: 28mm;
        background: linear-gradient(90deg, var(--accent), transparent);
      }
      h1 {
        margin: 0;
        font-size: 26pt;
        font-weight: 600;
        line-height: 1.02;
        letter-spacing: -0.035em;
        color: var(--ink);
      }
      .role {
        margin: 2mm 0 0;
        font-size: 12pt;
        font-weight: 500;
        letter-spacing: -0.01em;
        color: var(--accent);
      }
      .headline { margin: 1.5mm 0 0; font-size: 9pt; color: var(--soft); }
      .contacts {
        display: flex;
        flex-wrap: wrap;
        gap: 1mm 5mm;
        margin: 3mm 0 0;
        padding: 0;
        list-style: none;
        font-size: 9.2pt;
        color: var(--ink);
      }
      .contacts li { position: relative; }
      .contacts li + li::before {
        content: "";
        position: absolute;
        left: -2.5mm;
        top: 0.9mm;
        bottom: 0.9mm;
        border-left: 1px solid var(--line);
      }
      .availability {
        margin: 1.5mm 0 0;
        font-family: "Geist Mono Variable", "Geist Mono", ui-monospace, monospace;
        font-size: 8pt;
        letter-spacing: 0.04em;
        color: var(--soft);
      }

      /* ---------- sections ---------- */
      h2.sec {
        position: relative;
        margin: 0;
        padding: 2.5mm 0 1.6mm;
        font-family: "Geist Mono Variable", "Geist Mono", ui-monospace, monospace;
        font-size: 8.6pt;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--accent);
        border-bottom: 1px solid var(--line);
      }
      p { margin: 0; }
      .lead { font-weight: 500; color: var(--ink); }

      /* ---------- experience ---------- */
      .entry-head { padding-top: 1mm; }
      .entry-line {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 6mm;
      }
      .entry-role {
        font-size: 11pt;
        font-weight: 600;
        letter-spacing: -0.015em;
        color: var(--ink);
      }
      .entry-period,
      .entry-location {
        font-family: "Geist Mono Variable", "Geist Mono", ui-monospace, monospace;
        font-size: 8.2pt;
        color: var(--soft);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .entry-company { font-size: 10pt; font-weight: 500; color: var(--accent); }
      .entry-desc { color: var(--body); }
      .hl { padding-left: 4.2mm; text-indent: -4.2mm; }
      .hl::before { content: "–"; color: var(--accent); margin-right: 2.2mm; }
      .hl strong { color: var(--ink); font-weight: 600; }
      .entry-stack {
        font-family: "Geist Mono Variable", "Geist Mono", ui-monospace, monospace;
        font-size: 8pt;
        color: var(--soft);
      }
      .stack-label {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--body);
      }

      /* ---------- skills ---------- */
      .skill-row {
        display: grid;
        grid-template-columns: 42mm 1fr;
        gap: 5mm;
        align-items: baseline;
      }
      .skill-title { font-weight: 600; color: var(--ink); }
      .skill-items { color: var(--body); }

      /* ---------- languages ---------- */
      .langs { display: flex; flex-wrap: wrap; gap: 1.5mm 8mm; }
      .lang strong { color: var(--ink); font-weight: 600; }

      /* ---------- print: pages are already laid out, just emit them ---------- */
      @page { size: A4; margin: 0; }
      @media print {
        html { background: #fff; }
        .no-print { display: none !important; }
        #stage { padding: 0; height: auto !important; }
        #paper { gap: 0; transform: none !important; }
        .page {
          box-shadow: none;
          outline: none;
          /* a hair under A4 so sub-pixel rounding can't push a blank sheet after each page */
          height: 296.6mm;
          break-after: page;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        .page:last-child { break-after: auto; }
      }
    </style>
  </body>
</html>
