---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "./Navbar.astro";
import HeroSection from "./HeroSection.astro";
import AboutSection from "./AboutSection.astro";
import TechStackSection from "./TechStackSection.astro";
import ExperienceSection from "./ExperienceSection.astro";
import EducationSection from "./EducationSection.astro";
import ContactSection from "./ContactSection.astro";
import { getSiteMeta } from "../services";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const meta = getSiteMeta(lang);
---

<BaseLayout lang={lang}>
  <Navbar lang={lang} />
  <main>
    <HeroSection lang={lang} />
    <AboutSection lang={lang} />
    <TechStackSection lang={lang} />
    <ExperienceSection lang={lang} />
    <EducationSection lang={lang} />
    <ContactSection lang={lang} />
  </main>
  <footer class="border-t border-border/60">
    <div class="container py-10 grid grid-cols-12 gap-4 items-center font-mono text-[11px] text-muted-foreground tracking-wider">
      <div class="col-span-12 sm:col-span-6">{meta.footerText}</div>
      <div class="col-span-12 sm:col-span-6 sm:text-right flex sm:justify-end items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-primary pulse-dot"></span>
        <span class="text-foreground/70">v1.0 · TASHKENT · UZ</span>
      </div>
    </div>
  </footer>
</BaseLayout>
